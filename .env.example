# Comma-separated email addresses allowed to access the prelaunch portal.
PRELAUNCH_ADMIN_EMAILS=admin@example.com

# Use a strong password and configure it only in Hostinger.
PRELAUNCH_ADMIN_PASSWORD=replace-with-a-strong-password

# Generate a random secret of at least 32 characters and configure it only in Hostinger.
PRELAUNCH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Keep false during prelaunch. Change only after production storage is configured.
SUPPORT_REQUESTS_ENABLED=false

# Existing production integrations. Leave blank until the full portal launch.
COMMITTEE_ADMIN_EMAILS=admin@example.com
GOOGLE_APPS_SCRIPT_URL=
