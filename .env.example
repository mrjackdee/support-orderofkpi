# KP Support Center settings. Placeholders only: set the real values in Hostinger, never in git.

# The member portal this copy trusts (test copy: https://test.orderofkpi.com).
PORTAL_URL=https://test.orderofkpi.com
# Shared with the portal's SUPPORT_SSO_CLIENT_SECRET. Each copy has its own.
SUPPORT_SSO_CLIENT_SECRET=replace-with-the-secret-registered-on-the-portal
# At least 32 random characters. Signs CSRF tokens and hashes session cookies.
SESSION_SECRET=replace-with-at-least-32-random-characters
# This site's public address. support.orderofkpi.com makes it the live site.
SUPPORT_URL=https://test-support.orderofkpi.com
# Folder outside the web root for support.db and uploads/. Back it up daily.
SUPPORT_DATA_DIR=/home/example/support-data

# Email. Leave SMTP_HOST empty to record emails as NOT_CONFIGURED instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Order of KP Member Support <info@kpi2012.org>
# Fallback only. Failure alerts go to the list administrators keep on the Member Portal Admin
# Dashboard, fetched every 10 minutes. This is used only until that list is first fetched.
# Unset: cto@orderofkpi.org.
SUPPORT_ALERT_EMAILS=
# Who gets the daily digest. Unset: the alert list.
SUPPORT_DIGEST_EMAILS=digest@example.org

# true or false. Unset: off on support.orderofkpi.com, on everywhere else.
SUPPORT_REQUESTS_ENABLED=
